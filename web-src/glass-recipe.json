          ]
        }
      ]
    }
  },
  "surfaces": {
    "_note": "filter 只写 blur —— 彩度/亮度/对比度的压缩统一来自 backdrop.levels，由 tools/gen-glass-recipe.js 生成 --gr-cmp-<档位>，运行时按通透度档位插值。两个轴混在这里就会重演「表面自带 saturate、曲线又 saturate 一次」的双重饱和。",
    "tabbar": {
      "light": {
        "filter": "blur(28px)",
        "shadow": "0 0 0 .5px rgba(0,0,0,.05), 0 -1px 0 rgba(255,255,255,.7) inset, 0 -8px 24px rgba(0,0,0,.06), 0 -20px 48px rgba(0,0,0,.04)",
        "specular": "rgba(255,255,255,.88)",
        "rgbTop": "255,255,255",
        "rgbBot": "245,245,247",
        "alphaMin": 0.52,
        "alphaMax": 0.72
      },
      "dark": {
        "filter": "blur(28px)",
        "shadow": "0 0 0 .5px rgba(255,255,255,.10), 0 -1px 0 rgba(255,255,255,.30) inset, 0 -8px 24px rgba(0,0,0,.30)",
        "specular": "rgba(255,255,255,.28)",
        "rgbTop": "30,32,40",
        "rgbBot": "14,15,18",
        "alphaMin": 0.28,
        "alphaMax": 0.45
      }
    },
    "sheet": {
      "light": {
        "tintTop": "rgba(255,255,255,.92)",
        "tintBot": "rgba(245,245,247,.86)",
        "filter": "blur(40px)",
        "shadow": "inset 0 1px 0 rgba(255,255,255,.9), 0 -12px 48px rgba(0,0,0,.12), 0 -2px 8px rgba(0,0,0,.06)",
        "specular": "rgba(255,255,255,.95)"
      },
      "dark": {
        "tintTop": "rgba(28,28,30,.92)",
        "tintBot": "rgba(20,20,22,.86)",
