        "shadow": "inset 0 1px 0 rgba(255,255,255,.12), 0 -12px 48px rgba(0,0,0,.5), 0 -2px 8px rgba(0,0,0,.3)",
        "specular": "rgba(255,255,255,.32)"
      }
    },
    "card": {
      "_note": "已停用：滚动层不做真玻璃（2026-08-12 决策，逐元素 backdrop-filter 在 WebView 滚动时反复重采样背景必闪）。保留这段只为说明卡片为什么不该有玻璃参数；生成器不再输出 --gr-card-*。",
      "disabled": true
    }
  },
  "lens": {
    "_note": "rim/specular 是静态回退值（无壁纸时用）。有壁纸时运行时按 measureWallFloor 顺手量到的『药丸背后底部条带』平均色重新推导，参数见下面 specular 段。数值口径来自 2026-09-23 对参考实现的逐像素取样：亮带峰值比内外两侧都高 +58/255、彩度从 70% 降到 37%（×0.53）；顶缘反而是暗肩，比内部低 54/255。一亮一暗由光源方向决定，所以 lightAngle 是必需参数而不是装饰。",
    "specular": {
      "lightAngle": -60,
      "lift": 0.227,
      "satScale": 0.53,
      "alpha": 0.85,
      "darkDrop": 0.212,
      "darkAlpha": 0.34
    },
    "optics": {
      "_note": "WWDC25 解析视频同款：边到边玻璃板，折射集中在屏幕角落大曲率处。band 固定 16px（33-apple.js），refraction 14px；真机定稿待验。",
      "refraction": 14,
      "bezel": 1,
      "curvature": 2.5,
      "ior": 1.6
    },
    "rim": "inset 0 0 0 .5px rgba(255,255,255,.55), inset 0 1px 1px rgba(255,255,255,.8), inset 0 -1px 1px rgba(0,0,0,.05)",
    "rimDark": "inset 0 0 0 .5px rgba(255,255,255,.24), inset 0 1px 1px rgba(255,255,255,.28), inset 0 -1px 1px rgba(0,0,0,.10)",
    "innerGlow": "inset 0 0 30px 1px rgba(255,255,255,.06)",
    "innerGlowDark": "inset 0 0 30px 1px rgba(255,255,255,.04)",
    "aberration": "inset 1px 0 0 rgba(120,170,255,.06), inset -1px 0 0 rgba(255,150,120,.05)"
  },
  "motion": {
    "_note": "spring 供共享药丸与底栏 morph 使用；squish 五项是隐藏调参面板（长按「全局质感」标题）的默认值，由 32-boot.js 的 SQT_DEF 从 --gr-squish-* 读取，别再在 JS 里抄第二份。decel 已删：代码库里另有 --ease-apple-decel 且是不同曲线，这条没有消费者。",
    "spring": "cubic-bezier(.28,1.7,.55,1)",
    "pillBackMs": 460,
    "squish": {
      "max": 7,
      "press": 0.975,
      "stretch": 0.06,
      "squash": 0.035,
      "back": 460
    }
  }
}
