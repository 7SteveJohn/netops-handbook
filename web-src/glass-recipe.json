{
  "_note": "玻璃配方表：全站玻璃表面的唯一参数来源。改这里 → tools/gen-glass-recipe.js 生成 css/00-recipe.css → 表面只读 --gr-* 变量。数值口径来自 2026-09-23 对 14 张内置壁纸穿过真实 CSS 滤镜的实测（见 tools/data/wall-lum.json 与 README 的质感一节）。",
  "backdrop": {
    "_note": "动态范围压缩曲线。t = 通透度档位（10 最透 / 95 最厚）。chain 是**有序**滤镜序列，顺序有意义：浅色必须先 contrast 压向中灰、再 brightness 整体抬向白；反过来会把刚压平的亮度带重新撑开。2026-09-23 由网格搜索定档（14 张内置壁纸 × 明暗 × 156 组候选，两遍真实滤镜链、常量取自 32-boot.js 的 --bg-bri/--bg-blur 与 measureWallFloor combo），目标是在所需板厚不超过该档 baseA（滑杆保持有效）的前提下让最差壁纸的亮度带尽量宽。blur 是 .wall 与各表面自己的轴，不进这条曲线。",
    "saturate": "180%",
    "light": {
      "levels": [
        { "t": 10, "blur": 14, "chain": [["contrast", 0.15], ["brightness", 1.8]] },
        { "t": 52, "blur": 9,  "chain": [["contrast", 0.25], ["brightness", 1.6]] },
        { "t": 95, "blur": 5,  "chain": [["contrast", 0.9],  ["brightness", 1.4]] }
      ]
    },
    "dark": {
      "levels": [
        { "t": 10, "blur": 14, "chain": [["brightness", 0.5], ["contrast", 0.9]] },
        { "t": 52, "blur": 9,  "chain": [["brightness", 0.5], ["contrast", 0.7]] },
        { "t": 95, "blur": 5,  "chain": [["brightness", 0.7], ["contrast", 0.9]] }
      ]
    }
  },
  "surfaces": {
    "_note": "filter 只写 blur —— 彩度/亮度/对比度的压缩统一来自 backdrop.levels，由 tools/gen-glass-recipe.js 生成 --gr-cmp-<档位>，运行时按通透度档位插值。两个轴混在这里就会重演「表面自带 saturate、曲线又 saturate 一次」的双重饱和。",
    "tabbar": {
      "light": {
        "tintTop": "rgba(255,255,255,.72)",
        "tintBot": "rgba(245,245,247,.62)",
        "filter": "blur(28px)",
        "shadow": "0 0 0 .5px rgba(0,0,0,.05), 0 -1px 0 rgba(255,255,255,.7) inset, 0 -8px 24px rgba(0,0,0,.06), 0 -20px 48px rgba(0,0,0,.04)",
        "specular": "rgba(255,255,255,.88)"
      },
      "dark": {
        "tintTop": "rgba(20,20,22,.72)",
        "tintBot": "rgba(20,20,22,.56)",
        "filter": "blur(28px)",
        "shadow": "0 0 0 .5px rgba(255,255,255,.08), 0 -1px 0 rgba(255,255,255,.12) inset, 0 -8px 24px rgba(0,0,0,.32)",
        "specular": "rgba(255,255,255,.28)"
      }
    },
    "sheet": {
      "light": {
        "tintTop": "rgba(255,255,255,.92)",
        "tintBot": "rgba(245,245,247,.86)",
        "filter": "blur(40px)",
        "shadow": "inset 0 1px 0 rgba(255,255,255,.9), 0 -12px 48px rgba(0,0,0,.12), 0 -2px 8px rgba(0,0,0,.06)",
        "specular": "rgba(255,255,255,.95)"
      },
      "dark": {
        "tintTop": "rgba(28,28,30,.92)",
        "tintBot": "rgba(20,20,22,.86)",
        "filter": "blur(40px)",
        "shadow": "inset 0 1px 0 rgba(255,255,255,.12), 0 -12px 48px rgba(0,0,0,.5), 0 -2px 8px rgba(0,0,0,.3)",
        "specular": "rgba(255,255,255,.32)"
      }
    },
    "card": {
      "light": {
        "tintTop": "rgba(255,255,255,.20)",
        "tintBot": "rgba(250,250,252,.14)",
        "border": "rgba(255,255,255,.35)"
      },
      "dark": {
        "tintTop": "rgba(44,44,46,.52)",
        "tintBot": "rgba(32,32,36,.40)",
        "border": "rgba(255,255,255,.14)"
      }
    }
  },
  "lens": {
    "rim": "inset 0 0 0 .5px rgba(255,255,255,.55), inset 0 1px 1px rgba(255,255,255,.8), inset 0 -1px 1px rgba(0,0,0,.05)",
    "rimDark": "inset 0 0 0 .5px rgba(255,255,255,.24), inset 0 1px 1px rgba(255,255,255,.28), inset 0 -1px 1px rgba(0,0,0,.10)",
    "innerGlow": "inset 0 0 30px 1px rgba(255,255,255,.06)",
    "innerGlowDark": "inset 0 0 30px 1px rgba(255,255,255,.04)",
    "aberration": "inset 1px 0 0 rgba(120,170,255,.06), inset -1px 0 0 rgba(255,150,120,.05)"
  },
  "motion": {
    "spring": "cubic-bezier(.34,1.56,.64,1)",
    "decel": "cubic-bezier(.05,.7,.1,1)",
    "pillBackMs": 460,
    "squish": {
      "max": 7,
      "press": 0.975,
      "stretch": 0.06,
      "squash": 0.035,
      "back": 460
    }
  }
}
