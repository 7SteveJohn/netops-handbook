# 发布签名配置模板（本文件可提交；真实密钥文件 keystore.properties 已被 .gitignore 忽略）
# 用法：把本文件复制为 keystore.properties，填入你自己的值后，即可在 Android Studio
#       执行 Build → Generate Signed Bundle / APK，或在 Gradle 中 assembleRelease 自动签名。

# 密钥库文件路径：相对项目根目录（D:\Android），或填绝对路径
storeFile=app/release-key.jks

# 密钥库密码（keytool 生成时你设置的 -storepass）
storePassword=CHANGE_ME_storepass

# 密钥别名（keytool 生成时你设置的 -alias）
keyAlias=netops

# 密钥密码（keytool 生成时你设置的 -keypass，可与 storePassword 相同）
keyPassword=CHANGE_ME_keypass
